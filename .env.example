# Database — PostgreSQL (required for Vercel; SQLite file DBs don't work on serverless)
# Create a free serverless Postgres at https://neon.tech (or Supabase / Vercel Postgres)
# and paste the connection string here.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Dahl Inference API (OpenAI-compatible) — https://inference.dahl.global/docs/
DAHL_API_BASE=https://inference.dahl.global/v1
DAHL_API_KEY=your-dahl-api-key-here
DAHL_MODEL=MiniMaxAI/MiniMax-M2.7

# Optional: real SMTP for OTP email verification.
# If unset, the app runs in "dev mode" and shows the OTP code on screen.
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=465
# SMTP_USER=your@smtp.user
# SMTP_PASS=your-smtp-password
# SMTP_FROM="CareerAssist <no-reply@yourdomain.com>"
