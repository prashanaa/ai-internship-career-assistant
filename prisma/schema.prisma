// Prisma schema for AI Internship & Career Assistant

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Vercel runs on Linux x86_64; this ensures the correct query-engine binary
  // is fetched during `prisma generate`.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  password       String
  course         String?
  college        String?
  emailVerified  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  resumes       Resume[]
  applications  Application[]
  notifications Notification[]

  @@index([email])
}

model Resume {
  id         String   @id @default(cuid())
  userId     String
  fileName   String
  rawText    String
  parsedData String  // JSON string of ParsedResume
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Company {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  password       String
  industry       String?
  contactPerson  String?
  location       String?
  emailVerified  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  internships Internship[]

  @@index([email])
}

model Internship {
  id          String   @id @default(cuid())
  title       String
  company     String   // display name (from company account or seeded)
  location    String
  duration    String
  stipend     String
  category    String
  skills      String   // JSON array of required skills (AI-extracted filters)
  description String?
  openings    Int      @default(1)   // number of posts
  companyId   String?                // null = seeded/legacy; set for company-posted
  postedBy    String   @default("seed") // "seed" | "company"
  createdAt   DateTime @default(now())

  postedByCompany Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications    Application[]
  notifications   Notification[]

  @@index([companyId])
}

model Application {
  id           String   @id @default(cuid())
  userId       String
  internshipId String
  status       String   @default("Applied")
  matchScore   Int      @default(0)
  appliedAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  internship Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([internshipId])
}

model Notification {
  id           String   @id @default(cuid())
  userId       String
  internshipId String
  message      String
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  internship Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([internshipId])
}

// One-time codes for email verification (students + companies)
model OtpCode {
  id        String   @id @default(cuid())
  email     String   // the email being verified
  code      String   // 6-digit code
  role      String   // 'student' | 'company'
  purpose   String   @default("register") // 'register' | 'login'
  consumed   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([code])
}
