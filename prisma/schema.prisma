// Prisma schema for AI Internship & Career Assistant

generator client {
  provider = "prisma-client-js"
  // Covers local dev (native) + Vercel's Linux runtimes:
  //   - linux-musl-openssl-3.0.x  → Alpine/musl (Node 22+ on Vercel)
  //   - debian-openssl-3.0.x      → Debian glibc with OpenSSL 3 (Node 22)
  //   - debian-openssl-1.1.x      → Debian glibc with OpenSSL 1.1 (Node 18/20)
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  // Transaction pooler (port 6543, pgbouncer) — used at runtime for queries.
  url = env("DATABASE_URL")
  // Session pooler (port 5432) — used for `prisma db push` / migrations,
  // which the transaction pooler can't run (no prepared statements).
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(cuid())
  supabaseUid   String   @unique   // Supabase auth.users id
  name          String
  email         String   @unique
  course        String?
  college       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  resumes       Resume[]
  applications  Application[]
  notifications Notification[]

  @@index([email])
}

model Resume {
  id         String   @id @default(cuid())
  userId     String
  fileName   String
  rawText    String
  parsedData String  // JSON string of ParsedResume
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Company {
  id             String   @id @default(cuid())
  supabaseUid    String   @unique   // Supabase auth.users id
  name           String
  email          String   @unique
  industry       String?
  contactPerson  String?
  location       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  internships Internship[]

  @@index([email])
}

model Internship {
  id          String   @id @default(cuid())
  title       String
  company     String   // display name (from company account or seeded)
  location    String
  duration    String
  stipend     String
  category    String
  skills      String   // JSON array of required skills (AI-extracted filters)
  description String?
  openings    Int      @default(1)   // number of posts
  companyId   String?                // null = seeded/legacy; set for company-posted
  postedBy    String   @default("seed") // "seed" | "company"
  createdAt   DateTime @default(now())

  postedByCompany Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications    Application[]
  notifications   Notification[]

  @@index([companyId])
}

model Application {
  id           String   @id @default(cuid())
  userId       String
  internshipId String
  status       String   @default("Applied")
  matchScore   Int      @default(0)
  appliedAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  internship Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([internshipId])
}

model Notification {
  id           String   @id @default(cuid())
  userId       String
  internshipId String
  message      String
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  internship Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([internshipId])
}
